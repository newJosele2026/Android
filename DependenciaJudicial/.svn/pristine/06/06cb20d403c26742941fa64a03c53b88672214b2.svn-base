package com.slt.dependenciajudicial.requests.models;

import com.google.gson.annotations.Expose;
import com.google.gson.annotations.SerializedName;

/**
 * Created by Nelsy Acuña on 11/12/2017.
 */

public class SoportesModel {

    @SerializedName("iIDDJSolicitudSoporte")
    @Expose
    private Integer iIDDJSolicitudSoporte;

    @SerializedName("tDirectorio")
    @Expose
    private String tPath;

    @SerializedName("tNombreArchivoOriginal")
    @Expose
    private String tNombreArchivo;

    @SerializedName("tNombreArchivo")
    @Expose
    private String tNombreArchivoServer;

    private String tExtension;

    public String gettPath() {
        return tPath;
    }

    public void settPath(String tPath) {
        this.tPath = tPath;
    }

    public String gettNombreArchivo() {
        return tNombreArchivo;
    }

    public void settNombreArchivo(String tNombreArchivo) {
        this.tNombreArchivo = tNombreArchivo;
    }

    public String gettExtension() {
        return tExtension;
    }

    public void settExtension(String tExtension) {
        this.tExtension = tExtension;
    }

    public String gettNombreArchivoServer() {
        return tNombreArchivoServer;
    }

    public void settNombreArchivoServer(String tNombreArchivoServer) {
        this.tNombreArchivoServer = tNombreArchivoServer;
    }

    public Integer getiIDDJSolicitudSoporte() {
        return iIDDJSolicitudSoporte;
    }

    public void setiIDDJSolicitudSoporte(Integer iIDDJSolicitudSoporte) {
        this.iIDDJSolicitudSoporte = iIDDJSolicitudSoporte;
    }
}
