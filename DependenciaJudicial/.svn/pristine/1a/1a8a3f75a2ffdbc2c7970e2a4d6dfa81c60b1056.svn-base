package com.slt.dependenciajudicial.requests.models;

import java.util.Date;

/**
 * Created by Nelsy Acuña on 02/02/2018.
 */

public class ChatModel {

    private Integer iIDChat;
    private Boolean isMe;
    private String tMensaje;
    private Integer iIDDJSolicitud;
    private Integer iIDDJUsuario;
    private Integer iIDUsuario;
    private Date dtFechaMensaje;

    //region Constructores


    public ChatModel(Boolean isMe, String tMensaje, Date dtFechaMensaje) {
        this.isMe = isMe;
        this.tMensaje = tMensaje;
        this.dtFechaMensaje = dtFechaMensaje;
    }

    public ChatModel() {}

    public ChatModel(Boolean isMe, String tMensaje) {
        this.isMe = isMe;
        this.tMensaje = tMensaje;
    }

    public ChatModel(Integer iIDChat, Boolean isMe, String tMensaje) {
        this.iIDChat = iIDChat;
        this.isMe = isMe;
        this.tMensaje = tMensaje;
    }

    public ChatModel(Integer iIDChat, Boolean isMe, String tMensaje, Integer iIDDJSolicitud) {
        this.iIDChat = iIDChat;
        this.isMe = isMe;
        this.tMensaje = tMensaje;
        this.iIDDJSolicitud = iIDDJSolicitud;
    }

    public ChatModel(Integer iIDChat, Boolean isMe, String tMensaje, Integer iIDDJSolicitud, Integer iIDDJUsuario, Integer iIDUsuario, Date dtFechaMensaje) {
        this.iIDChat = iIDChat;
        this.isMe = isMe;
        this.tMensaje = tMensaje;
        this.iIDDJSolicitud = iIDDJSolicitud;
        this.iIDDJUsuario = iIDDJUsuario;
        this.iIDUsuario = iIDUsuario;
        this.dtFechaMensaje = dtFechaMensaje;
    }

    //endregion

    //region Get and Set

    public Boolean getMe() {
        return isMe;
    }

    public void setMe(Boolean me) {
        isMe = me;
    }

    public String gettMensaje() {
        return tMensaje;
    }

    public void settMensaje(String tMensaje) {
        this.tMensaje = tMensaje;
    }

    public Integer getiIDChat() {
        return iIDChat;
    }

    public void setiIDChat(Integer iIDChat) {
        this.iIDChat = iIDChat;
    }

    public Integer getiIDDJSolicitud() {
        return iIDDJSolicitud;
    }

    public void setiIDDJSolicitud(Integer iIDDJSolicitud) {
        this.iIDDJSolicitud = iIDDJSolicitud;
    }

    public Integer getiIDDJUsuario() {
        return iIDDJUsuario;
    }

    public void setiIDDJUsuario(Integer iIDDJUsuario) {
        this.iIDDJUsuario = iIDDJUsuario;
    }

    public Integer getiIDUsuario() {
        return iIDUsuario;
    }

    public void setiIDUsuario(Integer iIDUsuario) {
        this.iIDUsuario = iIDUsuario;
    }

    public Date getDtFechaMensaje() {
        return dtFechaMensaje;
    }

    public void setDtFechaMensaje(Date dtFechaMensaje) {
        this.dtFechaMensaje = dtFechaMensaje;
    }
    //endregion


}
