    //Metodo que calcual cuanto tiempo hay entre una fecha y otra
    public static String calcularDiferenciaFechasString(Date fechaInicio, Date fechaFin) {


        int diferencia = (int) ((fechaFin.getTime() - fechaInicio.getTime()) / 1000);

        int dias = 0;
        int horas = 0;
        int minutos = 0;
        if (diferencia > 86400) {
            dias = (int) Math.floor(diferencia / 86400);
            diferencia = diferencia - (dias * 86400);
        }
        if (diferencia > 3600) {
            horas = (int) Math.floor(diferencia / 3600);
            diferencia = diferencia - (horas * 3600);
        }
        if (diferencia > 60) {
            minutos = (int) Math.floor(diferencia / 60);
            diferencia = diferencia - (minutos * 60);
        }
        //"Hay "+dias+" dias, "+horas+" horas, "+minutos+" minutos y "+diferencia+" segundos de diferencia";

        //"Días:<b>" + dias + "</b> Horas:<b>" + horas + "</b> Min:<b>" + minutos + " Seg:<b>" + diferencia+"</b>"

        //"Días:<b>" + dias + "</b> Horas:<b>" + horas + "</b> Min:<b>" + minutos + " Seg:<b>" + diferencia + "</b>"

        String result = "";
        if (dias != 0) {

            result = (dias == 1 ? "<b>" + dias + "</b> día " : "<b>" + dias + "</b> días");
        } else if (horas != 0) {
            result = horas == 1 ? "<b>" + horas + "</b> hora " : "<b>" + horas + "</b> horas";
        } else if (minutos != 0) {
            result = minutos == 1 ? "<b>" + minutos + "</b> minuto " : "<b>" + minutos + "</b> minutos";
        }

        return !result.equals("") ? "Vigencia de " + result : "Expirado";


    }

    // Calcula la direfencia entre 2 fechas en segundos
    public static long calcularDiferenciaFechasSegundos(Date fechaInicio, Date fechaFin) {

        long milis1, milis2, diff;

        Calendar cinicio = Calendar.getInstance();
        Calendar cfinal = Calendar.getInstance();

        //ESTABLECEMOS LA FECHA DEL CALENDARIO CON EL DATE GENERADO ANTERIORMENTE
        cinicio.setTime(fechaInicio);
        cfinal.setTime(fechaFin);


        milis1 = cinicio.getTimeInMillis();

        milis2 = cfinal.getTimeInMillis();


        diff = milis2 - milis1;

        if (diff >= 0) {
            Log.d(LOG_ACTIVITY, "diff:" + (diff));

            // calcular la diferencia en segundos

            long diffSegundos = Math.abs(diff / 1000);


            // calcular la diferencia en minutos

            long diffMinutos = Math.abs(diff / (60 * 1000));


            long restominutos = diffMinutos % 60;


            // calcular la diferencia en horas

            long diffHoras = (diff / (60 * 60 * 1000));


            // calcular la diferencia en dias

            long diffdias = Math.abs(diff / (24 * 60 * 60 * 1000));

            return diffSegundos;


        } else {
            return 0;
        }


    }

    // Calcula la direfencia entre 2 fechas en segundos
    public static long calcularDiferenciaFechasDias(Date fechaInicio, Date fechaFin) {

        long milis1, milis2, diff;

        Calendar cinicio = Calendar.getInstance();
        Calendar cfinal = Calendar.getInstance();

        //ESTABLECEMOS LA FECHA DEL CALENDARIO CON EL DATE GENERADO ANTERIORMENTE
        cinicio.setTime(fechaInicio);
        cfinal.setTime(fechaFin);


        milis1 = cinicio.getTimeInMillis();

        milis2 = cfinal.getTimeInMillis();


        diff = milis2 - milis1;

        if (diff >= 0) {
            Log.d(LOG_ACTIVITY, "diff:" + (diff));

            // calcular la diferencia en segundos

            long diffSegundos = Math.abs(diff / 1000);


            // calcular la diferencia en minutos

            long diffMinutos = Math.abs(diff / (60 * 1000));


            long restominutos = diffMinutos % 60;


            // calcular la diferencia en horas

            long diffHoras = (diff / (60 * 60 * 1000));


            // calcular la diferencia en dias

            long diffdias = Math.abs(diff / (24 * 60 * 60 * 1000));

            return diffdias;


        } else {
            return 0;
        }


    }

    // MEtodo que suma minutos a una fecha
    public static Date sumarMinutosFecha(Date fecha, int dias) {

        Calendar calendar = Calendar.getInstance();

        calendar.setTime(fecha); // Configuramos la fecha que se recibe
        calendar.add(Calendar.MINUTE, dias);  // numero de días a añadir, o restar en caso de días<0
        return calendar.getTime(); // Devuelve el objeto Date con los nuevos días añadidos

    }

    // Metodo que toma la unidad de tiempo y el tiempo y lo pasa a minutos
    public static int pasarTiempoSolicitudMinutos(Integer iTiempo, String tUnidad) {

        int minutos = 0;

        if (tUnidad.equals("1")) {
            minutos = iTiempo;
        } else if (tUnidad.equals("2")) {
            minutos = iTiempo * 60;
        } else if (tUnidad.equals("3")) {
            minutos = iTiempo * 60 * 24;
        }
        return minutos;
    }

    public static int getPixelValue(Context context, int dimenId) {
        Resources resources = context.getResources();
        return (int) TypedValue.applyDimension(
                TypedValue.COMPLEX_UNIT_DIP,
                dimenId,
                resources.getDisplayMetrics()
        );
    }

    // Metodo que formatea una fecha
    public static String generalDateFormatter(Date dtFecha,String sFormatter){

        SimpleDateFormat formateador = new SimpleDateFormat(sFormatter);
        return formateador.format(dtFecha);
    }

    // Metodo que retorna la fecha formateada en la que un menjase fue escrito
    public static String dateDiffFormater(Date dtFecha){

        Integer iDias = 6;
        Date dtCurrentDate = new Date();
        String tResult = "";

        // Sumar dias a la fecha
        Calendar calendar = Calendar.getInstance();
        calendar.setTime(dtFecha); // Configuramos la fecha que se recibe
        calendar.add(Calendar.DAY_OF_YEAR, iDias);

        Log.d(LOG_ACTIVITY,"calendar.getTime :"+calendar.getTime());


        // Validar que la fecha actual no sea mayor a la fecha sumada
        if(dtCurrentDate.before(calendar.getTime())){

            Log.d(LOG_ACTIVITY,"Fecha del mensaje  no es superior a 6 dias ");
            Log.d(LOG_ACTIVITY,"Diferencia entre fechas "+calcularDiferenciaFechasDias(dtFecha,dtCurrentDate));
            //Fecha Actual no superior a 6 dias
            //validar si la fecha actual es la mismo que la fecha de hoy
            switch ( (int)calcularDiferenciaFechasDias(dtFecha,dtCurrentDate)){

                case 0: //hoy

                    tResult = "Hoy a las "+ generalDateFormatter(dtFecha,"HH:mm:ss");

                    break;

                case 1: //ayer
                    tResult = "Ayer a las "+ generalDateFormatter(dtFecha,"HH:mm:ss");
                    break;

                default: // otro dia

                    Calendar now = Calendar.getInstance();
                    now.setTime(dtFecha);
                    String strDiaSemana = strDays[now.get(Calendar.DAY_OF_WEEK) - 1];
                    strDiaSemana = strDiaSemana.substring(0,3);

                    tResult = strDiaSemana +" "+ generalDateFormatter(dtFecha,"HH:mm:ss");
                    break;


            }

        }else{
            Log.d(LOG_ACTIVITY,"Fecha del mensaje es superior a 6 dias ");
            //Fecha Actual mayor a 6 dias
            tResult = generalDateFormatter(dtFecha,"dd/MM/yyyy HH:mm:ss");

        }


        Log.d(LOG_ACTIVITY,"tResult :"+tResult);

        return tResult;
    }


