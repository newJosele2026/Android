    public static String currencyFormat(Integer s) {

        DecimalFormatSymbols symbols = new DecimalFormatSymbols();
        symbols.setGroupingSeparator(',');
        String pattern = "$#,##0.###";
        DecimalFormat decimalFormat = new DecimalFormat(pattern, symbols);

        return decimalFormat.format(s);
    }

    // Metodo que valida si el dispositivo esta conectado por WIFI
    public static boolean isConnectedWifi(Context context) {
        ConnectivityManager connectivityManager = (ConnectivityManager) context.getSystemService(Context.CONNECTIVITY_SERVICE);
        NetworkInfo networkInfo = connectivityManager.getActiveNetworkInfo();
        return networkInfo != null && networkInfo.getType() == ConnectivityManager.TYPE_WIFI;
    }

    // Metodo que valida si un teléfono esta conectado por DATOS (3G,4G, etc)
    public static boolean isConnectedMobile(Context context) {
        ConnectivityManager connectivityManager = (ConnectivityManager) context.getSystemService(Context.CONNECTIVITY_SERVICE);
        NetworkInfo networkInfo = connectivityManager.getActiveNetworkInfo();
        return networkInfo != null && networkInfo.getType() == ConnectivityManager.TYPE_MOBILE;
    }

    //Metodo que valida si el telefo esta conectado a un proveedor de internet (WIFI ,DATOS)
    public static boolean isConnected(Context context) {
        boolean connected = false;
        ConnectivityManager connec = (ConnectivityManager) context.getSystemService(Context.CONNECTIVITY_SERVICE);

        // Recupera todas las redes (tanto móviles como wifi)
        NetworkInfo[] redes = connec.getAllNetworkInfo();

        for (int i = 0; i < redes.length; i++) {
            // Si alguna red tiene conexión, se devuelve true
            if (redes[i].getState() == NetworkInfo.State.CONNECTED) {
                connected = true;
            }
        }
        return connected;
    }

    //Metodo que valida si el token de sesion es valido
    public static boolean isSesion(Activity activity) {

        String token = Preferences.getPreferences(activity, DependenciaJudicialUtils.SP_TOKEN);


        if (!token.equals("")) {

            Date dtExpired = Preferences.getTokenDataExpired(Preferences.getPreferences(activity, DependenciaJudicialUtils.SP_TOKEN));

            Log.d(LOG_ACTIVITY, "dtExpired:" + dtExpired);
            Log.d(LOG_ACTIVITY, "Date:" + new Date());

            if (dtExpired != null) {
                if (dtExpired.before(new Date())) {

                    Log.d(LOG_ACTIVITY, "Token existe pero ya expiro");

                    //Token existe pero ya expiro
                    Preferences.clearPreferences(activity);
                    return false;
                } else {

                    Log.d(LOG_ACTIVITY, "Sesion valida");

                    //Sesion valida
                    return true;
                }

            } else {

                Log.d(LOG_ACTIVITY, "Error al consultar la fecha");
                //Error al consultar la fecha
                Preferences.clearPreferences(activity);
                return false;
            }

        } else {

            Log.d(LOG_ACTIVITY, "Los datos de sesion no estan");
            //Los datos de sesion no estan
            Preferences.clearPreferences(activity);
            return false;
        }

    }

    //Metodo que valida si el texto es un email valido
    public static boolean isEmailValid(String email) {
        String regExpn = "^[_A-Za-z0-9-\\+]+(\\.[_A-Za-z0-9-]+)*@" + "[A-Za-z0-9-]+(\\.[A-Za-z0-9]+)*(\\.[A-Za-z]{2,})$";

        CharSequence inputStr = email;

        Pattern pattern = Pattern.compile(regExpn, Pattern.CASE_INSENSITIVE);
        Matcher matcher = pattern.matcher(inputStr);

        if (matcher.matches()) {

            Log.d(LOG_ACTIVITY, "isEmailValid: Si");
            return true;
        } else {
            Log.d(LOG_ACTIVITY, "isEmailValid: No");
            return false;
        }


    }

    //Metodo que valida si una contraseña cumple con la expresion regular
    public static boolean isPasswordValid(String pass) {
        String regExpn = "(?=^.{8,}$)((?=.*\\d)|(?=.*\\W+))(?![.\\n])(?=.*[A-Z])(?=.*[a-z]).*$";

        CharSequence inputStr = pass;

        Pattern pattern = Pattern.compile(regExpn, Pattern.CASE_INSENSITIVE);
        Matcher matcher = pattern.matcher(inputStr);

        if (matcher.matches()) {

            Log.d(LOG_ACTIVITY, "isPasswordValid: Si");
            return true;
        } else {
            Log.d(LOG_ACTIVITY, "isPasswordValid: No");
            return false;
        }


    }

    //Metodo que actualiza el badge del NavigationView
    public static void showMenuCountBag(Activity activity, NavigationView navigationView, Integer idMenu, String count) {

        TextView recorder = (TextView) MenuItemCompat.getActionView(navigationView.getMenu().findItem(idMenu));

        recorder.setGravity(Gravity.CENTER_VERTICAL);
        recorder.setTypeface(null, Typeface.BOLD);
        recorder.setTextColor(activity.getResources().getColor(R.color.colorAccent));
        recorder.setText(count);

    }

    // Metodo que permite visualizar todas los extras del Bundle
    public static String bundle2string(Bundle bundle) {
        if (bundle == null) {
            return null;
        }
        String string = "{";
        for (String key : bundle.keySet()) {
            string += " " + key + " => " + bundle.get(key) + ";";
        }
        string += " }";
        return string;
    }

    //Metodo que limpia las notificaciones del dispositivo
    public static void clearNotificacion(Context activity, String code) {

        String ns = Context.NOTIFICATION_SERVICE;
        NotificationManager nMgr = (NotificationManager) activity.getSystemService(ns);
        nMgr.cancel(Integer.parseInt(code));

    }

    //Metodo que retorna una fecha formateada en dd/MM/yyyy HH:mm:ss
    public static String getFormatoFechaDateTime(String strDate) {

        String result = " - ";

        Log.d(LOG_ACTIVITY, "strDate:" + strDate);

        if (!strDate.equals("")) {

            SimpleDateFormat formatter = new SimpleDateFormat("yyyy-MM-dd HH:mm:ss");
            Date date = null;
            try {
                date = formatter.parse(strDate);

                Log.d(LOG_ACTIVITY, "date:" + date.toString());

            } catch (ParseException e) {
                e.printStackTrace();
                date = null;
            }

            if (date != null) {

                result = new SimpleDateFormat("dd/MM/yyyy HH:mm:ss").format(date);

                Log.d(LOG_ACTIVITY, "result:" + result);

                return result;
            } else {
                return result;
            }

        } else {

            return result;
        }

    }

