    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        setContentView(R.layout.activity_gestionar_solicitud);
        ButterKnife.bind(this);

        soportesModels = new ArrayList<>();
        apiService = ApiUtils.getSOService();
        setupToolbar(strBarTitle + " " + Preferences.getPreferences(this, SP_IIDSOLICITUD_TEM), true);
        setupPermisos();
        setupRVServicios();
        setupProgressDialog();

    }

    public List<SoportesModel> obtenerSoportesUsuarioSolicitud() {

        List<SoportesModel> soportesModels = new ArrayList<>();
        String path = FileUtils.folderApp() + Preferences.getPreferences(this, SP_IIDDJUSUARIO) + "/" + Preferences.getPreferences(this, SP_IIDSOLICITUD_TEM) + "/";
        soportesModels = FileUtils.getListFileFolder(path, soportesModels);
        return soportesModels;
    }

    public void setupToolbar(String tittle, boolean upButton) {

        setSupportActionBar(toolbar);
        getSupportActionBar().setTitle(tittle);
        getSupportActionBar().setDisplayHomeAsUpEnabled(upButton);


    }

    private void setupPermisos() {

        // Get runtime permissions if build version >= Android M
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.M) {

            if ((ContextCompat.checkSelfPermission(this, Manifest.permission.WRITE_EXTERNAL_STORAGE) != PackageManager.PERMISSION_GRANTED) ||
                    (ContextCompat.checkSelfPermission(this, Manifest.permission.CAMERA)
                            != PackageManager.PERMISSION_GRANTED) ||
                    (ContextCompat.checkSelfPermission(this, Manifest.permission.READ_EXTERNAL_STORAGE)
                            != PackageManager.PERMISSION_GRANTED)) {
                requestPermissions(new String[]{Manifest.permission.WRITE_EXTERNAL_STORAGE,
                                Manifest.permission.READ_EXTERNAL_STORAGE,
                                Manifest.permission.CAMERA},
                        PERMISSION_REQUEST_WRITE_EXTERNAL_STORAGE_RESULT);
            }
        }

    }

    private void setupRVServicios() {

        //Obtener datos de los servicios disponibles
        LinearLayoutManager llm = new LinearLayoutManager(this);
        llm.setOrientation(LinearLayoutManager.VERTICAL);
        // rvServicios.setHasFixedSize(true);
        rvSoportes.setLayoutManager(llm);


        CallbackRVSoportes callbackRVSoportes = new CallbackRVSoportes() {


            @Override
            public void onCallbackSoportesTouchContent(SoportesModel soportesModel) {


                if (soportesModel.gettExtension().equals("pdf")) {

                    PdfUtils.openIntentPdf(ActivityGestionarSolicitud.this, soportesModel.gettPath());
                }

            }

            @Override
            public void onCallbackSoportesBtnDelete(final SoportesModel soportesModel) {

                new MaterialDialog.Builder(ActivityGestionarSolicitud.this)
                        .title(strDialogoEliminarTitle)
                        .content(strDialogoEliminarContenido + " " + soportesModel.gettNombreArchivo())
                        .positiveText(strDialogoEliminarBtnEliminar)
                        .onPositive(new MaterialDialog.SingleButtonCallback() {
                            @Override
                            public void onClick(MaterialDialog dialog, DialogAction which) {
                                // TODO

                                FileUtils.deleteFile(soportesModel.gettPath());

                                soportesModels = obtenerSoportesUsuarioSolicitud();
                                getUpdateListSoportesModel();

                            }
                        })
                        .negativeText(strDialogoEliminarBtnCancelar)
                        .show();

            }
        };

        adapter = new RVAdapterSoportes(this, soportesModels, callbackRVSoportes);
        rvSoportes.setAdapter(adapter);
    }

    private void getUpdateListSoportesModel() {

        adapter.updateRVAdapterSoportes(soportesModels);

        if (soportesModels != null && soportesModels.size() != 0)
            lyNoSoportes.setVisibility(View.GONE);
        else
            lyNoSoportes.setVisibility(View.VISIBLE);


    }

    @OnClick(R.id.activity_gestionar_solicitud_btn_adjuntar)
    public void onClickBtnAdjuntarSoporte(View v) {

        // Check if permissions are granted
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.M) {
            if (ContextCompat.checkSelfPermission(this,
                    Manifest.permission.WRITE_EXTERNAL_STORAGE)
                    != PackageManager.PERMISSION_GRANTED) {
                requestPermissions(new String[]{Manifest.permission.WRITE_EXTERNAL_STORAGE,
                                Manifest.permission.READ_EXTERNAL_STORAGE,
                                Manifest.permission.CAMERA},
                        PERMISSION_REQUEST_WRITE_EXTERNAL_STORAGE_RESULT);
            } else {
                getImages();
            }
        } else {
            getImages();
        }


    }

    @OnClick(R.id.activity_gestionar_solicitud_btn_cumplir)
    public void onClickBtnCumplir(final View view) {

        if (DependenciaJudicialUtils.isConnected(this)) {

            if (soportesModels != null && soportesModels.size() != 0) {


                Log.d(LOG_ACTIVITY, "SP_CONFIGURACION_RED_MOVIL:" + Preferences.getPreferences(this, SP_CONFIGURACION_RED_MOVIL));
                if (Preferences.getPreferences(this, SP_CONFIGURACION_RED_MOVIL).equals("0")) {

                    Log.d(LOG_ACTIVITY, "Cualquier conexion");

                    cumplirEvent(view);

                } else {

                    Log.d(LOG_ACTIVITY, "Solo wifi");
                    if (DependenciaJudicialUtils.isConnectedWifi(this)) {

                        Log.d(LOG_ACTIVITY, "Hay wifi");
                        cumplirEvent(view);

                    } else {

                        Log.d(LOG_ACTIVITY, "no hay wifi");
                        new MaterialDialog.Builder(ActivityGestionarSolicitud.this)
                                .title(strDialogoGeneralTitulo)
                                .content(strDialogoSoloWifi)
                                .positiveText(strDialogoGeneralBtnok)
                                .show();
                    }

                }


            } else {

                new MaterialDialog.Builder(ActivityGestionarSolicitud.this)
                        .title(strDialogoGeneralTitulo)
                        .content(strBtnDialogoCumplirContenido)
                        .positiveText(strDialogoGeneralBtnok)
                        .show();

            }


        } else {


            Snackbar.make(view, strGeneralSinConexion, Snackbar.LENGTH_SHORT).show();
        }


    }

    private void cumplirEvent(final View view) {

        showProgressDialog(strProgressBntCumplirContenido);

        //Subir archivos
        List<MultipartBody.Part> parts = new ArrayList<>();

        int countPart = 0;

        for (SoportesModel soportesModel : soportesModels) {
            parts.add(prepareFilePart("part" + countPart, soportesModel.gettPath()));
            ++countPart;
        }


        RequestBody requestBody = createPartFromString(Preferences.getPreferences(ActivityGestionarSolicitud.this, SP_IIDSOLICITUD_TEM));

        String tToken = Preferences.getPreferences(ActivityGestionarSolicitud.this, SP_TOKEN);

        callCumplirSolicitud = apiService.CumplirSolicitud(tToken, requestBody, parts);

        callCumplirSolicitud.enqueue(new Callback<BasicRequestModel>() {
            @Override
            public void onResponse(Call<BasicRequestModel> call, Response<BasicRequestModel> response) {

                dissProgressDialog();

                if (response.isSuccessful()) {

                    Log.d(LOG_ACTIVITY, "response.isSuccessful():" + response.isSuccessful());

                    if (response.code() != CODE_SESION_EXPIRE) {

                        Log.d(LOG_ACTIVITY, "response.code():" + response.code());

                        if (response.body() != null && response.body().getToken() != null) {

                            Preferences.savePreferences(ActivityGestionarSolicitud.this, DependenciaJudicialUtils.SP_TOKEN, response.body().getToken());

                            Log.d(LOG_ACTIVITY, "response.body().getResult():" + response.body().getResult());

                            switch (response.body().getResult()) {
                                case 1: // Todo Ok

                                    //mensaje de ok
                                    new MaterialDialog.Builder(ActivityGestionarSolicitud.this)
                                            .title(strDialogoGeneralTitulo)
                                            .content(strDialogCumplirCumplido)
                                            .positiveText(strDialogoGeneralBtnok)
                                            .cancelable(false)
                                            .onPositive(new MaterialDialog.SingleButtonCallback() {
                                                @Override
                                                public void onClick(@NonNull MaterialDialog dialog, @NonNull DialogAction which) {

                                                    finish();
                                                }
                                            })
                                            .show();

                                    break;
                                case 2: // Error al subir Archivos

                                    //Mensaje de error en el servidor
                                    new MaterialDialog.Builder(ActivityGestionarSolicitud.this)
                                            .title(strDialogoGeneralTitulo)
                                            .content(strDialogCumplirFileError)
                                            .positiveText(strDialogoGeneralBtnok)
                                            .show();

                                    break;
                                case 3: //Error al actualizar el estado

                                    //Mensaje de no se pudo actualizar
                                    new MaterialDialog.Builder(ActivityGestionarSolicitud.this)
                                            .title(strDialogoGeneralTitulo)
                                            .content(strDialogCumplirEstadoError)
                                            .positiveText(strDialogoGeneralBtnok)
                                            .onPositive(new MaterialDialog.SingleButtonCallback() {
                                                @Override
                                                public void onClick(@NonNull MaterialDialog dialog, @NonNull DialogAction which) {
                                                    finish();
                                                }
                                            })
                                            .show();
                                    break;
                                case 4: //Error de token en el servidor

                                    Preferences.savePreferences(ActivityGestionarSolicitud.this, SP_TOKEN, "");
                                    finish();
                                    break;
                            }


                        } else {

                            Snackbar.make(view, strGeneralSinConexionServidor, Snackbar.LENGTH_LONG).show();
                        }

                    } else {

                        //el token ya vencio
                        Preferences.savePreferences(ActivityGestionarSolicitud.this, SP_TOKEN, "");
                        finish();

                    }


                } else {


                    Snackbar.make(view, strGeneralSinConexionServidor, Snackbar.LENGTH_LONG).show();

                }


            }

            @Override
            public void onFailure(Call<BasicRequestModel> call, Throwable t) {


                Log.d(LOG_ACTIVITY, "call.isCanceled()" + call.isCanceled());

                dissProgressDialog();

                if (!call.isCanceled()) {

                    Snackbar.make(view, strGeneralSinConexionServidor, Snackbar.LENGTH_LONG).show();
                }


            }
        });


    }

    @OnClick(R.id.activity_gestionar_solicitud_btn_cancelar)
    public void onClickBtnCancelar(final View view) {

        if (DependenciaJudicialUtils.isConnected(ActivityGestionarSolicitud.this)) {


            new MaterialDialog.Builder(ActivityGestionarSolicitud.this)
                    .title(strDialogoGeneralTitulo)
                    .content(strDialogoCancelarContenido)
                    .positiveText(strGeneralDialogoBtnConfirmar)
                    .negativeText(strGeneralDialogoBtnVolver)
                    .onPositive(new MaterialDialog.SingleButtonCallback() {
                        @Override
                        public void onClick(@NonNull MaterialDialog dialog, @NonNull DialogAction which) {


                            String tToken = Preferences.getPreferences(ActivityGestionarSolicitud.this, SP_TOKEN);

                            Integer iIDDJSolicitud = Integer.parseInt(Preferences.getPreferences(ActivityGestionarSolicitud.this, SP_IIDSOLICITUD_TEM));

                            showProgressDialog(strProgressCancelar);

                            apiService.CancelarSolicitud(tToken, iIDDJSolicitud).enqueue(new Callback<BasicRequestModel>() {
                                @Override
                                public void onResponse(Call<BasicRequestModel> call, Response<BasicRequestModel> response) {

                                    dissProgressDialog();

                                    if (response.isSuccessful()) {

                                        if (response.code() != CODE_SESION_EXPIRE) {

                                            if (response.body() != null && response.body().getToken() != null) {


                                                switch (response.body().getResult()) {


                                                    case 1:

                                                        //mensaje de ok
                                                        new MaterialDialog.Builder(ActivityGestionarSolicitud.this)
                                                                .title(strDialogoGeneralTitulo)
                                                                .content(strDialogoCancelarCancelado)
                                                                .positiveText(strDialogoGeneralBtnok)
                                                                .cancelable(false)
                                                                .onPositive(new MaterialDialog.SingleButtonCallback() {
                                                                    @Override
                                                                    public void onClick(@NonNull MaterialDialog dialog, @NonNull DialogAction which) {

                                                                        finish();
                                                                    }
                                                                })
                                                                .show();

                                                        break;

                                                    case 2:

                                                        Snackbar.make(view, strGeneralSinConexionServidor, Snackbar.LENGTH_LONG).show();
                                                        break;
                                                }


                                            } else {
                                                Snackbar.make(view, strGeneralSinConexionServidor, Snackbar.LENGTH_LONG).show();
                                            }


                                        } else {

                                            Preferences.savePreferences(ActivityGestionarSolicitud.this, SP_TOKEN, "");
                                            finish();
                                        }

                                    } else {

                                        Snackbar.make(view, strGeneralSinConexionServidor, Snackbar.LENGTH_LONG).show();

                                    }


                                }

                                @Override
                                public void onFailure(Call<BasicRequestModel> call, Throwable t) {
                                    dissProgressDialog();

                                    if (!call.isCanceled()) {

                                        Snackbar.make(view, strGeneralSinConexionServidor, Snackbar.LENGTH_LONG).show();
                                    }

                                }
                            });


                        }
                    })
                    .show();


        } else {

            Snackbar.make(view, strGeneralSinConexion, Snackbar.LENGTH_SHORT).show();
        }


    }

