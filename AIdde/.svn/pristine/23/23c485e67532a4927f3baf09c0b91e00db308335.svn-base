<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
package="com.slt.dependenciajudicial">

<!-- Permisos de internet -->
<uses-permission android:name="android.permission.INTERNET" />
<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

<!-- Permisos para leer y escribir en el dispositivo -->
<uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
<uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

<!-- Permisos para la camara -->
<uses-feature android:name="android.hardware.camera" />
<uses-feature
    android:name="android.hardware.camera.autofocus"
    android:required="false" />

<uses-permission android:name="android.permission.CAMERA" />

<application
    android:name=".app.DependenciaJudicialApplication"
    android:allowBackup="true"
    android:icon="@mipmap/ic_launcher"
    android:label="@string/app_name"
    android:roundIcon="@mipmap/ic_launcher_round"
    android:largeHeap="true"
    android:supportsRtl="true"
    android:theme="@style/DependenciaJudicialTheme">

    <activity
        android:name=".views.activity.ActivitySplash"
        android:screenOrientation="portrait">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />

            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
    </activity>
    <activity
        android:name=".views.activity.ActivityLogin"
        android:launchMode="singleTask"
        android:screenOrientation="portrait" />
    <activity
        android:name=".views.activity.ActivityHome"
        android:allowTaskReparenting="true"
        android:windowSoftInputMode="stateHidden"
        android:screenOrientation="portrait" />
    <activity
        android:name=".views.activity.ActivityRegistro"
        android:parentActivityName=".views.activity.ActivityLogin"
        android:screenOrientation="portrait"
        android:windowSoftInputMode="stateHidden">
        <meta-data
            android:name="android.support.PARENT_ACTIVITY"
            android:value=".views.activity.ActivityLogin" />
    </activity>

    <activity
        android:name=".views.activity.ActivityGestionarSolicitud"
        android:parentActivityName=".views.activity.ActivityHome"
        android:screenOrientation="portrait">
        <meta-data
            android:name="android.support.PARENT_ACTIVITY"
            android:value=".views.activity.ActivityHome" />
    </activity>


    <activity
        android:name=".views.activity.ActivityChat"
        android:windowSoftInputMode="stateHidden"
        android:parentActivityName=".views.activity.ActivityGestionarSolicitud"
        android:screenOrientation="portrait">
        <meta-data
            android:name="android.support.PARENT_ACTIVITY"
            android:value=".views.activity.ActivityGestionarSolicitud" />
    </activity>


    <!-- <activity
                android:name="com.gun0912.tedpicker.ImagePickerActivity"
                android:screenOrientation="portrait"
                android:theme="@style/DependenciaJudicialTheme_picker" /> -->

    <activity
        android:name="com.esafirm.imagepicker.features.ImagePickerActivity"
        android:configChanges="orientation|screenSize"
        android:screenOrientation="portrait"
        android:theme="@style/ef_AppTheme"/>

    <!-- [START firebase_service] -->
    <service android:name=".app.gcm.MyFirebaseMessagingService">
        <intent-filter>
            <action android:name="com.google.firebase.MESSAGING_EVENT" />
        </intent-filter>
    </service>
    <!-- [END firebase_service] -->


    <!-- [START firebase_iid_service] -->
    <service android:name=".app.gcm.MyFirebaseInstanceIDService">
        <intent-filter>
            <action android:name="com.google.firebase.INSTANCE_ID_EVENT" />
        </intent-filter>
    </service>
    <!-- [END firebase_iid_service] -->


    <!--
 Set custom default icon. This is used when no icon is set for incoming notification messages.
 See README(https://goo.gl/l4GJaQ) for more.
    -->
    <meta-data
        android:name="com.google.firebase.messaging.default_notification_icon"
        android:resource="@mipmap/ic_launcher" />
    <!--
         Set color used with incoming notification messages. This is used when no color is set for the incoming
         notification message. See README(https://goo.gl/6BKBk7) for more.
    -->
    <meta-data
        android:name="com.google.firebase.messaging.default_notification_color"
        android:resource="@color/colorAccent" />


</application>

</manifest>