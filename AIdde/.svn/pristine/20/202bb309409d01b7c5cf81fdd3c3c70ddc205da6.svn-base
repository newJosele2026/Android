package com.slt.dependenciajudicial.requests.models;

import com.google.gson.annotations.Expose;
import com.google.gson.annotations.SerializedName;

/**
 * Created by Nelsy Acuña on 07/03/2018.
 */

public class FuenteExternaModel {

    @SerializedName("iIDFuentesExternas")
    @Expose
    private Integer iIDFuentesExternas;
    @SerializedName("tNombreFuente")
    @Expose
    private String tNombreFuente;

    public FuenteExternaModel(Integer iIDFuentesExternas, String tNombreFuente) {
        this.iIDFuentesExternas = iIDFuentesExternas;
        this.tNombreFuente = tNombreFuente;
    }

    //region Get and Set

    public Integer getIIDFuentesExternas() {
        return iIDFuentesExternas;
    }

    public void setIIDFuentesExternas(Integer iIDFuentesExternas) {
        this.iIDFuentesExternas = iIDFuentesExternas;
    }

    public String getTNombreFuente() {
        return tNombreFuente;
    }

    public void setTNombreFuente(String tNombreFuente) {
        this.tNombreFuente = tNombreFuente;
    }
    //endregion



}
